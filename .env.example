# Synthetic, single-user localhost development only. Not shared authentication.
GOLDENLOOP_LOCAL_DEMO=true
GOLDENLOOP_DATA_DIR=.goldenloop
GOLDENLOOP_ALLOW_LIVE_SYNTHETIC=false

# Optional live sandbox execution. Install workspace live extras explicitly.
# Prefer `az login`; API keys are optional and must not be committed.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_COMPLETION_MODEL=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=

# Independently configured live judge; explicit opt-in, synthetic data only.
GOLDENLOOP_ALLOW_LIVE_SYNTHETIC_JUDGE=false
GOLDENLOOP_JUDGE_ENDPOINT=
GOLDENLOOP_JUDGE_DEPLOYMENT=
GOLDENLOOP_JUDGE_API_VERSION=
GOLDENLOOP_JUDGE_API_KEY=
