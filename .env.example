# Synthetic, single-user localhost development only. Not shared authentication.
GOLDENLOOP_LOCAL_DEMO=true
GOLDENLOOP_DATA_DIR=.goldenloop
GOLDENLOOP_ALLOW_LIVE_SYNTHETIC=false

# V2 registered agents: operator-approved connection metadata, never key values.
# uv --env-file loads this single-quoted JSON. Empty object keeps mock setup offline.
GOLDENLOOP_CONNECTION_BINDINGS='{}'
# Create a project in the UI first; replace PROJECT_ID with its displayed ID.
# Example only: replace the origin and allowlist locally, then restart the API.
# GOLDENLOOP_CONNECTION_BINDINGS='{"foundry-agent":{"endpoint":"https://example.openai.azure.com","auth":"api_key","key_env":"GOLDENLOOP_AGENT_API_KEY","projects":["PROJECT_ID"]}}'
GOLDENLOOP_AGENT_API_KEY=
# For Azure CLI use auth="azure_cli", omit key_env, and run az login.
# In Agents, create a NEW revision, enable live, select the binding, and enter
# deployment/API version. Install live extras and opt in above before execution.
# Binding readiness is configuration only; it does not probe the deployment.

# Legacy v1 API / legacy SDK demo invocation only, not v2 revision defaults.
# Empty key uses Azure CLI credentials. These settings do not configure new agents.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_COMPLETION_MODEL=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=

# Independent global live judge, snapshotted per run/export; not project bindings.
# Explicit opt-in for API execution, API key required, synthetic data only.
GOLDENLOOP_ALLOW_LIVE_SYNTHETIC_JUDGE=false
GOLDENLOOP_JUDGE_ENDPOINT=
GOLDENLOOP_JUDGE_DEPLOYMENT=
GOLDENLOOP_JUDGE_API_VERSION=
GOLDENLOOP_JUDGE_API_KEY=
