{
  "name": "GoldenLoop",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22.14.0" },
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "workspaceFolder": "/workspaces/goldenloop",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/goldenloop,type=bind,consistency=cached",
  "mounts": [
    "source=goldenloop-data-${devcontainerId},target=/var/lib/goldenloop,type=volume",
    "source=goldenloop-venv-${devcontainerId},target=/workspaces/goldenloop/.venv,type=volume",
    "source=goldenloop-node-modules-${devcontainerId},target=/workspaces/goldenloop/apps/web/node_modules,type=volume"
  ],
  "containerEnv": {
    "GOLDENLOOP_DATA_DIR": "/var/lib/goldenloop",
    "GOLDENLOOP_LOCAL_DEMO": "true",
    "GOLDENLOOP_ALLOW_LIVE_SYNTHETIC": "false",
    "UV_LINK_MODE": "copy",
    "UV_PYTHON": "3.12"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "GoldenLoop API (local synthetic only)", "onAutoForward": "silent" },
    "5173": { "label": "GoldenLoop web", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "remote.localPortHost": "localhost",
        "remote.autoForwardPorts": false
      }
    }
  }
}
